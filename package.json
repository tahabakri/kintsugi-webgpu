{
  "name": "kintsugi-webgpu",
  "version": "1.0.0",
  "description": "Real-time procedural ceramic fracture and interactive gold repair in WebGPU.",
  "private": true,
  "type": "module",
  "author": "Taha Bakri",
  "license": "MIT",
  "keywords": [
    "webgpu",
    "wgsl",
    "procedural-fracture",
    "kintsugi",
    "simulation",
    "computer-graphics",
    "rigid-body",
    "generative-art"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@webgpu/types": "^0.1.64",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  }
}
